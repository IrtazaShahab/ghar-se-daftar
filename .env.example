# Variable NAMES only. Put real values in .env.local (local) or the deployment
# environment. Never commit secrets. Only NEXT_PUBLIC_* values reach the browser,
# so no secret may use that prefix.

# App (use the deployed HTTPS origin in production; no trailing path)
NEXT_PUBLIC_APP_URL="http://localhost:3100"
NEXT_PUBLIC_BRAND_NAME="Ghar Se Daftar"
NEXT_PUBLIC_WHATSAPP_NUMBER="923704756269"

# Database (Supabase Postgres, used server-side by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Supabase Auth (browser-safe publishable key; the legacy anon key also works
# as NEXT_PUBLIC_SUPABASE_ANON_KEY). The service-role key is not used by the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application email: order notifications, admin alerts, corporate quotes.
# Separate from Supabase Auth emails (signup/reset), which Supabase sends itself.
# Server-only: never prefix these with NEXT_PUBLIC_. Leave EMAIL_PROVIDER empty to
# skip sending (each skipped email is still recorded in the Notification table).
# Test with: npm run email:test -- you@example.com
EMAIL_PROVIDER=            # "smtp" (Gmail) or "resend"
SMTP_HOST=                 # Gmail: smtp.gmail.com
SMTP_PORT=                 # Gmail: 465
SMTP_SECURE=               # true for 465, false for 587
SMTP_USER=                 # the Gmail address that sends
SMTP_PASS=                 # a Gmail App Password (16 characters), not the account password
EMAIL_FROM=                # e.g. Ghar Se Daftar <the same Gmail address>
RESEND_API_KEY=            # only when EMAIL_PROVIDER=resend
ADMIN_NOTIFICATION_EMAILS= # comma-separated inboxes for new order / corporate alerts

# Payments. Cash on Delivery needs nothing. Online providers stay "Coming soon"
# until their credentials are set AND their API integration is implemented
# (src/lib/payments/providers/online.ts). All server-only.
PAYMENT_ENVIRONMENT=       # "sandbox" or "production"
PREPAYMENT_REQUIRED_ABOVE_PKR= # optional: orders at/above this total can't use COD

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_BASE_URL=

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_BASE_URL=

CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=
CARD_GATEWAY_API_BASE_URL=

# Corporate bank transfer details shown on accepted quotations
CORPORATE_BANK_ACCOUNT_TITLE=
CORPORATE_BANK_NAME=
CORPORATE_BANK_IBAN=

# Monitoring
SENTRY_DSN=""
